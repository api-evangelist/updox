                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"<string>\",\n  \"applicationId\": \"<string>\",\n  \"applicationPassword\": \"<string>\",\n  \"lastRetrievedFaxId\": \"<string>\"\n}",
