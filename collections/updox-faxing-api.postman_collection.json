          "name": "Retrieve next inbound fax (PNG)",
          "request": {
            "name": "Retrieve next inbound fax (PNG)",
            "description": {
              "content": "Multifunction poll. Reports whether inbound faxes are queued, returns the oldest unhandled fax image (PNG) in the response, and marks the prior fax handled via lastRetrievedFaxId. Repeat until endOfQueue is true.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "FaxOemPop"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
